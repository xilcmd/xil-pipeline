{
    // Python formatting is Ruff, configured by [tool.ruff] in pyproject.toml
    // (line-length = 120). Pinning the formatter here stops editors from
    // falling back to black/autopep8, whose 88-column default silently
    // rewraps whole files.
    //
    // NOTE: these apply only when the FOLDER is open. Opening a single file
    // (e.g. Explorer -> "Open with Code") gives Ruff no project root, so it
    // falls back to its built-in 88-column default and reflows the file on
    // save. Open the repo folder, not individual files.
    //
    // formatOnSave is deliberately NOT enabled: 82 of 90 files predate
    // ruff-format, so saving would rewrite them wholesale and bury real
    // changes in formatting churn. Format explicitly (Shift+Alt+F) on code
    // you own, or run `ruff format <path>` as a deliberate, reviewable pass.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.rulers": [
            120
        ]
    },
    // Pylance's package index is disabled here on purpose.
    //
    // Measured 2026-08-17: indexing this folder's venv cost 29.5 s of
    // "scan packages" (571 files) plus 6.9 s of indexing at EVERY window
    // open. The venv lives on /mnt/c, so WSL reads it over drvfs at about
    // 19 files/s. "python.analysis.persistAllIndices" defaults to true and
    // should have made that a one-time cost, but no Pylance cache dir is
    // ever written under ~/.vscode-server/data/User/globalStorage, so the
    // full scan repeats on every start.
    //
    // Cost of turning it off: no auto-import suggestions for not-yet-
    // imported symbols, and no Ctrl+T symbol search inside library code.
    // Everything else (go-to-definition, hover, completion on imported
    // names, type checking) is unaffected. Delete this line to restore it.
    "python.analysis.indexing": false,
    "cSpell.words": [
        "Williamstown"
    ]
}
